
<Window x:Class="AirStream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirStream"
        Height="390"
        Width="430"
        MinHeight="350"
        MinWidth="400"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#17191E"
        Foreground="#FFFFFF">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#17191E"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#252830"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#3B82F6"/>

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0" Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="♫"
                           FontSize="25"
                           Foreground="#60A5FA"
                           VerticalAlignment="Center"/>

                <TextBlock Text="AirStream"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="0.1.0"
                           FontSize="10"
                           Foreground="#777777"
                           Margin="8,5,0,0"
                           VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>

        <!-- MAIN CONTENT -->

        <StackPanel Grid.Row="1">

            <TextBlock Text="AIRPLAY DEVICE"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#9297A3"
                       Margin="0,0,0,9"/>

            <ComboBox x:Name="DeviceComboBox"
                    Height="42"
                    FontSize="13"
                    Background="#252830"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="8"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="DeviceComboBox_SelectionChanged"/>

            <TextBlock x:Name="DeviceSearchText"
                    Text="Searching for AirPlay devices..."
                    FontSize="11"
                    Foreground="#9297A3"
                    Margin="2,8,0,0"/>

            <!-- STATUS -->

            <Grid Margin="0,18,0,18">

                <StackPanel Orientation="Horizontal">

                    <Ellipse x:Name="StatusIndicator"
                             Width="8"
                             Height="8"
                             Fill="#64748B"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="StatusText"
                               Text="Disconnected"
                               FontSize="12"
                               Foreground="#AAAAAA"
                               Margin="9,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock Text="Not streaming"
                           Foreground="#777777"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- CONNECT -->

            <Button x:Name="ConnectButton"
                    Content="Connect"
                    Style="{StaticResource PrimaryButton}"
                    Click="ConnectButton_Click"/>

            <!-- VOLUME -->

            <Grid Margin="0,24,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Volume"
                                   FontSize="12"
                                   Foreground="#AAAAAA"/>

                    </StackPanel>

                    <TextBlock x:Name="VolumeText"
                               Text="75%"
                               FontSize="12"
                               Foreground="White"
                               HorizontalAlignment="Right"/>

                </Grid>

                <Slider x:Name="VolumeSlider"
                        Grid.Row="1"
                        Minimum="0"
                        Maximum="100"
                        Value="75"
                        Margin="0,8,0,0"
                        ValueChanged="VolumeSlider_ValueChanged"/>

            </Grid>

        </StackPanel>

        <!-- FOOTER -->

        <Grid Grid.Row="2">

            <Border Height="1"
                    Background="#30333B"
                    VerticalAlignment="Top"/>

            <TextBlock Text="AirStream"
                       FontSize="10"
                       Foreground="#666666"
                       Margin="0,12,0,0"/>

            <TextBlock Text="Windows 11"
                       FontSize="10"
                       Foreground="#666666"
                       HorizontalAlignment="Right"
                       Margin="0,12,0,0"/>

        </Grid>

    </Grid>

</Window>
