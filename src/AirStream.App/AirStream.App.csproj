<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AirStream.Core\AirStream.Core.csproj" />
    <ProjectReference Include="..\AirStream.Audio\AirStream.Audio.csproj" />
    <ProjectReference Include="..\AirStream.AirPlay\AirStream.AirPlay.csproj" />
    <ProjectReference Include="..\AirStream.Discovery\AirStream.Discovery.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Build the standalone Rust engine whenever the WPF app is built. -->
  <Target Name="BuildAirStreamRustEngine" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="&quot;$(USERPROFILE)\.cargo\bin\cargo.exe&quot; build --release --manifest-path &quot;$(MSBuildProjectDirectory)\..\AirStream.Engine\Cargo.toml&quot;" />
  </Target>

  <!-- Place the engine beside the WPF executable for ProcessStartInfo. -->
  <Target Name="CopyAirStreamRustEngineToBuildOutput" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\AirStream.Engine\target\release\airstream-engine.exe"
          DestinationFiles="$(OutDir)AirStream.Engine.exe" />
  </Target>

  <!-- Also include the engine in dotnet publish output. -->
  <Target Name="CopyAirStreamRustEngineToPublishOutput" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\AirStream.Engine\target\release\airstream-engine.exe"
          DestinationFiles="$(PublishDir)AirStream.Engine.exe" />
  </Target>

</Project>
